---
import { GitHubLogoIcon, LinkedInLogoIcon } from '@radix-ui/react-icons'

import { buttonVariants } from '@ninprd/ui/components/button'

import { GITHUB_URL, LINKEDIN_URL } from '../constants'
---

<section id="hero" class="pt-16 sm:pt-24">
  <h1
    class="reveal text-3xl sm:text-4xl font-semibold tracking-tight text-balance"
  >
    Peeranat Danaidusadeekul
  </h1>
  <p
    class="reveal mt-3 text-sm text-muted-foreground"
    style="--reveal-delay: 60ms"
  >
    Software engineer at <span class="text-primary font-medium"
      >LINE MAN Wongnai</span
    >
  </p>
  <p
    class="reveal mt-4 max-w-md text-sm sm:text-base text-muted-foreground leading-relaxed text-pretty"
    style="--reveal-delay: 120ms"
  >
    I'm interested in web development and UX/UI design.
  </p>
  <div
    class="reveal mt-6 flex w-full flex-col gap-2 sm:flex-row"
    style="--reveal-delay: 180ms"
  >
    <a
      href={LINKEDIN_URL}
      class={`${buttonVariants()} press`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Linkedin profile of Peeranat Danaidusadeekul"
    >
      <LinkedInLogoIcon /> Linkedin
    </a>
    <a
      href={GITHUB_URL}
      class={`${buttonVariants({ variant: "outline" })} press`}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Github profile of Peeranat Danaidusadeekul"
    >
      <GitHubLogoIcon /> Github
    </a>
  </div>
</section>
