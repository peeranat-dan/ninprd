---
import { Image } from 'astro:assets'
import { LinkedInLogoIcon } from '@radix-ui/react-icons'

import { buttonVariants } from '@ninprd/ui/components/button'

import { cn } from '@ninprd/ui/lib/utils'
import aiAutomationPhoto from '../assets/faci/ai-automation.webp'
import groupWorkPhoto from '../assets/faci/group-work.webp'
import webDevBootcampPhoto from '../assets/faci/web-dev-bootcamp.webp'
import { ExperienceList } from '../components/faci/experience-list'
import { FACEBOOK_URL, LINKEDIN_URL } from '../constants'
import { FACI_EXPERIENCE, FACI_SINCE } from '../faci'
import Layout from '../layouts/Layout.astro'

const PHOTOS = [
  {
    src: aiAutomationPhoto,
    alt: 'Peeranat talking with a participant at the AI Automation Transformation workshop',
  },
  {
    src: webDevBootcampPhoto,
    alt: 'Peeranat debugging next to a learner at Web Development Bootcamp',
  },
  {
    src: groupWorkPhoto,
    alt: 'Peeranat working with a group at Product Management Bootcamp',
  },
]

const programCount = FACI_EXPERIENCE.filter(
  ({ role }) => role === 'facilitator' || role === 'ta',
).length
const STATS = [
  { value: programCount, label: 'Workshops & bootcamps' },
  { value: FACI_EXPERIENCE.length, label: 'Engagements in total' },
  { value: FACI_SINCE, label: 'Facilitating since' },
]
---

<Layout
  title="Facilitator · Peeranat Danaidusadeekul"
  description="Workshop facilitator and teaching assistant experience of Peeranat Danaidusadeekul - bootcamps, AI automation workshops, and talks."
>
  <main class="mx-auto max-w-2xl px-6 lg:px-0">
    <section id="hero" class="pt-16 sm:pt-24">
      <p
        class="reveal text-xs font-medium uppercase tracking-widest text-muted-foreground"
      >
        Facilitator &amp; teaching assistant
      </p>
      <h1
        class="reveal mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
        style="--reveal-delay: 60ms"
      >
        Peeranat Danaidusadeekul
      </h1>
      <p
        class="reveal mt-4 max-w-lg text-sm leading-relaxed text-muted-foreground text-pretty sm:text-base"
        style="--reveal-delay: 120ms"
      >
        Software engineer who facilitates workshops on the side. I switched into
        software from industrial engineering, so I still remember what being
        stuck feels like - and that is where I start explaining from.
      </p>
      <div
        class="reveal mt-6 flex w-full flex-col gap-2 sm:flex-row"
        style="--reveal-delay: 180ms"
      >
        <a
          href={FACEBOOK_URL}
          class={cn(buttonVariants(), "press")}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path
              d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
            ></path>
          </svg> Facebook
        </a>
        <a
          href={LINKEDIN_URL}
          class={cn(buttonVariants({ variant: "outline" }), "press")}
          target="_blank"
          rel="noopener noreferrer"
        >
          <LinkedInLogoIcon /> LinkedIn
        </a>
      </div>

      <dl
        class="reveal mt-10 grid grid-cols-3 gap-4 border-y py-5"
        style="--reveal-delay: 240ms"
      >
        {
          STATS.map(({ value, label }) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-xs text-muted-foreground text-pretty">{label}</dt>
              <dd class="text-2xl font-semibold tracking-tight tabular-nums">
                {value}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <ul class="mt-8 grid grid-cols-3 gap-2 sm:gap-3" aria-label="Photos">
      {
        PHOTOS.map(({ src, alt }, i) => (
          <li
            class="reveal overflow-hidden rounded-xl border border-border bg-muted"
            style={`--reveal-delay: ${300 + i * 50}ms`}
          >
            <Image
              src={src}
              alt={alt}
              class="aspect-3/2 w-full object-cover"
              widths={[240, 480, 720]}
              sizes="(min-width: 672px) 216px, 33vw"
              loading="eager"
            />
          </li>
        ))
      }
    </ul>

    <section id="experience" class="pt-16">
      <ExperienceList client:load />
    </section>

    <section id="contact" class="pt-16 pb-20">
      <div
        class="flex flex-col gap-4 rounded-xl border border-border bg-card p-6 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h2 class="text-base font-medium">Need a facilitator?</h2>
          <p class="mt-1 text-sm text-muted-foreground text-pretty">
            I'm happy to help at tech, product, and AI workshops.
          </p>
        </div>
        <div class="flex shrink-0 flex-col gap-2 sm:flex-row">
          <a
            href={FACEBOOK_URL}
            class={cn(buttonVariants(), "press")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"
              ></path>
            </svg> Facebook
          </a>
          <a
            href={LINKEDIN_URL}
            class={cn(buttonVariants({ variant: "outline" }), "press")}
            target="_blank"
            rel="noopener noreferrer"
          >
            <LinkedInLogoIcon /> LinkedIn
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
