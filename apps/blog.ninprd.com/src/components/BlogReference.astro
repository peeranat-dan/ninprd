---
import { Image } from 'astro:assets'
import { getEntry } from 'astro:content'

interface Props {
  id: string
  section?: string
}

const { id, section } = Astro.props

const post = await getEntry('blog', id)

if (!post) {
  return null
}

const { title, featuredImage, date } = post.data

const link = section ? `/blog/${id}#${section}` : `/blog/${id}`
---

<a
  href={link}
  class="blog-reference"
  target="_blank"
  rel="noopener noreferrer"
>
  <div class="flex gap-4 items-center">
    <Image
      src={featuredImage}
      alt={title}
      width={featuredImage.width}
      height={featuredImage.height}
      class="aspect-[120/63] object-cover max-w-36 shrink-0"
    />
    <div class="flex flex-col gap-2">
      <h3 class="text-lg font-medium no-underline">{title}</h3>
      <p class="text-sm text-gray-500">{date}</p>
    </div>
  </div>
</a>
