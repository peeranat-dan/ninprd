---
// Facebook and X are plain links. Copy and native share run in src/scripts/share.ts,
// which reads the data-share-* attributes below. Rename them in both files together.
import { buttonVariants } from '@ninprd/ui/components/button'
import { cn } from '@ninprd/ui/lib/utils'

import backgroundImage from '../../assets/blog-background.png'
import { shareTargets } from '../../lib/share-targets'

interface Props {
  title: string
  /** Use `canonicalUrl` from src/lib/canonical.ts. */
  url: string | URL
  postId: string
}

const { title, url, postId } = Astro.props
const canonical = url.toString()
const targets = shareTargets(canonical, title)

// Shrinks slightly when pressed.
const button = cn(
  buttonVariants({ variant: 'outline', size: 'sm' }),
  'transition-[color,background-color,border-color,transform] duration-150 ease-out motion-safe:active:scale-[0.97]',
  // Icon only on mobile.
  'max-md:size-9 max-md:px-0',
)
// Hidden on mobile, still read by screen readers.
const text = 'max-md:sr-only'
// Copy button states sit on top of each other and fade between each other.
const stacked =
  'col-start-1 row-start-1 transition-[opacity,filter,visibility] duration-150 ease-out not-data-active:invisible not-data-active:opacity-0 not-data-active:blur-[2px]'
const copyStates = [
  { state: 'idle', label: 'Copy link' },
  { state: 'copied', label: 'Link copied' },
  { state: 'failed', label: 'Copy failed' },
]
// On small screens the native Share button covers Facebook and X, so hide them once
// share.ts sets data-native-share. Without native share they stay visible.
const networkLink = `${button} max-md:group-data-native-share:hidden`
---

<nav
  aria-labelledby={`share-heading-${postId}`}
  data-share-section={postId}
  data-share-url={canonical}
  data-share-title={title}
  data-share-image-background={backgroundImage.src}
  class="group flex items-center gap-2 text-sm flex-wrap"
>
  <p id={`share-heading-${postId}`} class="text-muted-foreground">Share:</p>

  <a
    href={targets.facebook}
    target="_blank"
    rel="noopener noreferrer"
    data-share-network="facebook"
    class={networkLink}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.412c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.956.931-1.956 1.886v2.265h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"
      ></path>
    </svg>
    <span class={text}>Facebook</span>
    <span class="sr-only">(opens in a new window)</span>
  </a>

  <a
    href={targets.x}
    target="_blank"
    rel="noopener noreferrer"
    data-share-network="x"
    class={networkLink}
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path
        d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
      ></path>
    </svg>
    <span class={text}>X</span>
    <span class="sr-only">(opens in a new window)</span>
  </a>

  <button
    type="button"
    data-share-copy
    data-share-network="copy"
    class={button}
  >
    <span class="grid" aria-hidden="true">
      {
        copyStates.map(({ state }) => (
          <svg
            data-share-state={state}
            data-active={state === "idle" ? "" : undefined}
            class={stacked}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {state === "idle" && (
              <>
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
                <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
              </>
            )}
            {state === "copied" && <path d="M20 6 9 17l-5-5" />}
            {state === "failed" && (
              <>
                <path d="M18 6 6 18" />
                <path d="m6 6 12 12" />
              </>
            )}
          </svg>
        ))
      }
    </span>
    <span class:list={["grid justify-items-center", text]}>
      {
        copyStates.map(({ state, label }) => (
          <span
            data-share-label
            data-share-state={state}
            data-active={state === "idle" ? "" : undefined}
            class={stacked}
          >
            {label}
          </span>
        ))
      }
    </span>
  </button>

  <button
    type="button"
    data-share-image
    data-share-network="image"
    class={button}
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
      <circle cx="9" cy="9" r="2"></circle>
      <path d="m21 15-3.09-3.09a2 2 0 0 0-2.82 0L6 21"></path>
    </svg>
    <span class={text} data-share-image-label>Share as image</span>
  </button>

  <!-- Hidden until share.ts confirms navigator.share exists. -->
  <button
    type="button"
    data-share-native
    data-share-network="native"
    hidden
    class={button}
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line>
      <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line>
    </svg>
    <span class={text}>Share</span>
  </button>

  <p data-share-status role="status" aria-live="polite" class="sr-only"></p>
</nav>

<script src="../../scripts/share.ts"></script>
