---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props

// Filter to only show h2 and h3 headings
const filteredHeadings = headings.filter((h) => h.depth <= 3)
---

{
  filteredHeadings.length > 0 ? (
    <nav class="border border-border rounded-lg p-6 bg-muted/30">
      <h2 class="text-lg font-semibold mb-4 text-foreground">
        Table of Contents
      </h2>
      <ul class="space-y-2">
        {filteredHeadings.map((heading) => (
          <li
            class:list={[
              "text-sm",
              {
                "pl-0": heading.depth === 2,
                "pl-4": heading.depth === 3,
              },
            ]}
          >
            <a
              href={`#${heading.slug}`}
              class="text-muted-foreground hover:text-primary transition-colors duration-200 hover:underline underline-offset-4"
            >
              {heading.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  ) : null
}
