---
import { Github, Linkedin } from "lucide-react";
---

<footer class="mx-auto w-full max-w-5xl">
  <div
    class="flex flex-1 items-center justify-between gap-8 border-t px-6 py-8"
  >
    <p class="text-sm text-muted-foreground">
      © {new Date().getFullYear()} blog.ninprd. All rights reserved.
    </p>
    <div class="flex gap-4">
      <a
        href="https://www.linkedin.com/in/peeranatd/"
        target="_blank"
        rel="noreferrer"
        aria-label="Linkedin profile of Peeranat Danaidusadeekul"
      >
        <Linkedin strokeWidth={1} className="h-6 w-6 text-muted-foreground" />
      </a>
      <a
        href="https://github.com/peeranat-dan"
        target="_blank"
        rel="noreferrer"
        aria-label="Github profile of Peeranat Danaidusadeekul"
      >
        <Github strokeWidth={1} className="h-6 w-6 text-muted-foreground" />
      </a>
    </div>
  </div>
</footer>
