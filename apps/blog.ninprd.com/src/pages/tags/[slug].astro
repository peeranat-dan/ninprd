---
import { Image } from 'astro:assets'
import { getCollection } from 'astro:content'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@ninprd/ui/components/breadcrumb'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Layout from '../../layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const collection = await getCollection('blog')
  if (!collection) return []
  const postTags = collection.flatMap((post) => post.data.tags || [])
  const uniqueTags = Array.from(new Set(postTags))
  return uniqueTags.map((tag) => {
    return {
      params: {
        slug: tag,
      },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { slug } = Astro.params

const collection = await getCollection('blog')
const posts = collection
  .filter((post) => post.data.tags.includes(slug))
  .map((p) => {
    return {
      id: p.id,
      ...p.data,
    }
  })
---

<Layout
  title={`Posts tagged with "${slug}"`}
  description={`A list of posts tagged with "${slug}"`}
>
  <section class="max-w-4xl mx-auto space-y-8 px-4 lg:px-0 py-4">
    <div>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="text-primary font-semibold hover:text-primary"
              >หน้าหลัก</BreadcrumbLink
            >
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>tag: {slug}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
    <h1 set:html={`All posts tagged with: ${slug}`} />
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => {
          const { id, featuredImage, date, title, excerpt } = post
          return (
            <a href={`/blog/${id}`}>
              <div class="flex flex-col gap-4">
                <Image
                  src={featuredImage}
                  alt={`Cover of ${title}`}
                  width={featuredImage.width}
                  height={featuredImage.height}
                  class="rounded-md aspect-[120/63] object-cover"
                />
                <div class="space-y-2">
                  <h2
                    class="text-2xl font-medium line-clamp-3"
                    set:html={title}
                  />
                  <p
                    class="text-sm text-foreground/70 line-clamp-3"
                    set:html={excerpt}
                  />
                  <p class="text-xs text-muted-foreground">{date}</p>
                </div>
              </div>
            </a>
          )
        })
      }
    </div>
  </section>
</Layout>
