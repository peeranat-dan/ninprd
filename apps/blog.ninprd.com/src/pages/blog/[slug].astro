---
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@ninprd/ui/components/breadcrumb'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Layout from '../../layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const collection = await getCollection('blog')
  if (!collection) return []
  return collection.map((post) => {
    return {
      params: {
        slug: post.id,
      },
      props: {
        post: post,
      },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { title, featuredImage, excerpt, tags, date } = post.data
const { Content } = await render(post)

const allPosts = await getCollection('blog')

const relatedPosts = allPosts
  .filter(
    (p) => p.id !== post.id && p.data.tags.some((tag) => tags.includes(tag))
  )
  .slice(0, 3)
  .map((p) => {
    return { id: p.id, ...p.data }
  })
---

<Layout title={title} description={excerpt} image={featuredImage.src}>
  <section class="max-w-4xl mx-auto space-y-8 px-4 lg:px-0 py-4">
    <div>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="text-primary font-semibold hover:text-primary"
              >หน้าหลัก</BreadcrumbLink
            >
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
    <h1 set:html={title} />
    <Image
      src={featuredImage}
      alt={`Cover of ${title}`}
      width={featuredImage.width}
      height={featuredImage.height}
      class="aspect-[120/63] rounded-lg object-cover"
      loading="eager"
    />
    <article class="article-content">
      <Content />
    </article>
    <div class="flex flex-col gap-2">
      <div class="flex items-center gap-2 text-sm text-muted-foreground">
        <p>Tags:</p>
        {
          tags.map((tag) => (
            <span class="bg-muted/50 select-none text-muted-foreground px-2 py-1 rounded-md">
              {tag}
            </span>
          ))
        }
      </div>
      <div class="text-sm text-muted-foreground">
        Posted: {date}
      </div>
    </div>
    <section class="max-w-4xl mx-auto space-y-8 px-4 lg:px-0 py-4">
      <h3>Related Posts</h3>
      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {
          relatedPosts.map((post) => {
            const { id, featuredImage, title, excerpt, date } = post

            return (
              <a href={`/blog/${id}`}>
                <div class="flex flex-col gap-4">
                  <Image
                    src={featuredImage}
                    alt={`Cover of ${title}`}
                    width={featuredImage.width}
                    height={featuredImage.height}
                    class="rounded-md aspect-[120/63] object-cover"
                  />
                  <div class="space-y-2">
                    <h2 class="text-2xl font-medium" set:html={title} />
                    <p
                      class="text-sm text-foreground/70 line-clamp-3"
                      set:html={excerpt}
                    />
                    <p class="text-xs text-muted-foreground">{date}</p>
                  </div>
                </div>
              </a>
            )
          })
        }
      </div>
    </section>
  </section>
</Layout>
