---
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@ninprd/ui/components/breadcrumb'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import BlogCard from '../../components/BlogCard.astro'
import BlogPostingJsonLd from '../../components/BlogPostingJsonLd.astro'
import TableOfContent from '../../components/blog/TableOfContent.astro'
import Layout from '../../layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const collection = await getCollection('blog')
  if (!collection) return []
  return collection.map((post) => {
    return {
      params: {
        slug: post.id,
      },
      props: {
        post: post,
      },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { title, featuredImage, excerpt, tags, date, withTableOfContent } =
  post.data
const { Content, headings } = await render(post)

const hasCarousel = post.body?.includes(':::carousel') ?? false

const allPosts = await getCollection('blog')

const relatedPosts = allPosts
  .filter(
    (p) => p.id !== post.id && p.data.tags.some((tag) => tags.includes(tag)),
  )
  .slice(0, 4)
  .map((p) => {
    return { id: p.id, ...p.data }
  })
---

<Layout title={title} description={excerpt} image={featuredImage.src}>
  <BlogPostingJsonLd
    title={title}
    description={excerpt}
    image={featuredImage.src}
    date={date}
    tags={tags}
  />
  <section class="max-w-4xl mx-auto space-y-8 px-4 lg:px-0 py-4">
    <div>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="text-primary font-semibold hover:text-primary"
              >หน้าหลัก</BreadcrumbLink
            >
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
    <h1 set:html={title} />
    <Image
      src={featuredImage}
      alt={`Cover of ${title}`}
      width={featuredImage.width}
      height={featuredImage.height}
      class="aspect-120/63 rounded-lg object-cover"
      loading="eager"
    />
    {withTableOfContent ? <TableOfContent headings={headings} /> : null}
    <article class="article-content">
      <Content />
    </article>
    {hasCarousel && <script src="../../scripts/carousel.ts" />}
    <div class="flex flex-col gap-2">
      <div
        class="flex items-center gap-2 text-sm flex-wrap text-muted-foreground"
      >
        <p>Tags:</p>
        {
          tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="bg-muted/50 select-none text-muted-foreground px-2 py-1 rounded-md"
            >
              {tag}
            </a>
          ))
        }
      </div>
      <div class="text-sm text-muted-foreground">
        Posted: {date}
      </div>
    </div>
    {
      relatedPosts.length > 0 ? (
        <section class="border-t pt-8">
          <h3 class="text-xl font-semibold mb-6 text-foreground">
            Related Posts
          </h3>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            {relatedPosts.map((post) => (
              <BlogCard
                id={post.id}
                title={post.title}
                excerpt={post.excerpt}
                date={post.date}
                featuredImage={post.featuredImage}
              />
            ))}
          </div>
        </section>
      ) : null
    }
  </section>
</Layout>
