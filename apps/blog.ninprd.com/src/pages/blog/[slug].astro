---
import { Image } from 'astro:assets'
import { getCollection, render } from 'astro:content'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@ninprd/ui/components/breadcrumb'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import Layout from '../../layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const collection = await getCollection('blog')
  if (!collection) return []
  return collection.map((post) => {
    return {
      params: {
        slug: post.id,
      },
      props: {
        post: post,
      },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post } = Astro.props
const { title, featuredImage, excerpt } = post.data
const { Content } = await render(post)
---

<Layout title={title} description={excerpt} image={featuredImage.src} noindex>
  <section class="max-w-4xl mx-auto space-y-8 px-4 lg:px-0 py-4">
    <div class="">
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="text-primary font-semibold hover:text-primary"
              >หน้าหลัก</BreadcrumbLink
            >
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{title}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
    <h1 set:html={title} />
    <Image
      src={featuredImage}
      alt={`Cover of ${title}`}
      width={featuredImage.width}
      height={featuredImage.height}
      class="aspect-[120/63] rounded-lg"
      loading="eager"
    />
    <article class="article-content">
      <Content />
    </article>
  </section>
</Layout>
