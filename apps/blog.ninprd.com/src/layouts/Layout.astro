---
import { Font } from 'astro:assets'
import Analytics from '@vercel/analytics/astro'
import SpeedInsights from '@vercel/speed-insights/astro'
import Posthog from '../components/Posthog.astro'
import SEO from '../components/SEO.astro'
import { CookieConsentBanner } from '../components/cookie-consent/CookieConsentBanner'
import Footer from '../components/layout/Footer.astro'
import Header from '../components/layout/Header.astro'
import ThemeProvider from '../components/theme/ThemeProvider.astro'
import '../styles/globals.css'

interface Props {
  title?: string
  description?: string
  image?: string
  noindex?: boolean
  withAnalytics?: boolean
}

const {
  title,
  description,
  image,
  noindex = false,
  withAnalytics = true,
} = Astro.props
---

<html lang="en">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      noindex={noindex}
    />
    <ThemeProvider />
    {withAnalytics ? <Analytics /> : null}
    {withAnalytics ? <Posthog /> : null}
    <SpeedInsights />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.15.2/dist/katex.min.css"
    />
    <Font cssVariable="--font-sora" preload />
    <Font cssVariable="--font-jetbrains-mono" preload />
    <Font cssVariable="--font-ibm-plex-sans-thai-looped" preload />
    <Font cssVariable="--font-ibm-plex-sans-thai" preload />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <div class="relative flex min-h-screen flex-col">
      <Header />
      <main class="flex-auto">
        <slot />
      </main>
      <Footer />
    </div>
    <CookieConsentBanner client:only="react" />
  </body>
</html>
