---
import "../styles.css";
// Font imports
import "@fontsource-variable/jetbrains-mono";
import "@fontsource/ibm-plex-sans-thai-looped/400.css";
import "@fontsource/ibm-plex-sans-thai-looped/600.css";
import "@fontsource/ibm-plex-sans-thai-looped/700.css";
import "@fontsource/ibm-plex-sans-thai/400.css";
import "@fontsource/ibm-plex-sans-thai/500.css";
import "@fontsource/ibm-plex-sans-thai/600.css";
import "@fontsource/ibm-plex-sans-thai/700.css";
import "@fontsource-variable/sora";

import Header from "../components/layouts/Header.astro";
import ThemeProvider from "../components/theme/ThemeProvider.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description } = Astro.props;

const titleText = `${title} | ninprd`;
const descriptionText =
  description ??
  "Connect with Peeranat Danaidusadeekul (ninprd) - User-Centered Developer";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{titleText}</title>
    <meta name="robots" content="index,follow" />
    <ThemeProvider />
    <meta name="description" content={descriptionText} />
    <meta property="og:description" content={descriptionText} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={titleText} />
    <meta name="twitter:description" content={descriptionText} />
  </head>
  <body class="min-h-screen bg-background font-sans antialiased">
    <Header />
    <slot />
  </body>
</html>
