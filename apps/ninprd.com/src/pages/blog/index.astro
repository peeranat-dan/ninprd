---
import Layout from "../../layouts/Layout.astro";

import { getCollection } from "astro:content";

import { Image } from "astro:assets";

const posts = await getCollection("blog");

const allPosts = posts.map((post) => post.data);
const firstPost = allPosts[0];
const latestPosts = allPosts.slice(1, allPosts.length);
---

<Layout>
  <section class="container py-8 flex flex-col gap-8">
    <div class="text-center space-y-2">
      <h1>All blogs</h1>
      <p class="text-muted-foreground">บล็อกที่นิลเขียนมาทั้งหมด</p>
    </div>
    <a href={`/blog/${firstPost.slug}`}>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <Image
          src={firstPost.featuredImage.url}
          alt={firstPost.featuredImage.alt}
          inferSize
          loading="eager"
          class="rounded-md aspect-[120/63] object-cover"
        />
        <div class="flex flex-col gap-1">
          <span
            class="text-xs items-end bg-primary/30 rounded-full w-fit px-2 py-1"
          >
            {firstPost.category.name}
          </span>
          <h2 class="text-2xl font-medium" set:html={firstPost.title} />
          <p
            class="text-sm text-foreground/70 line-clamp-3"
            set:html={firstPost.excerpt}
          />
          <p class="text-xs text-muted-foreground">{firstPost.date}</p>
        </div>
      </div>
    </a>
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        latestPosts.map((post, index) => {
          const { slug, featuredImage, title, excerpt, category, date } = post;
          return (
            <a href={`/blog/${slug}`}>
              <div class="flex flex-col gap-4">
                <Image
                  src={featuredImage.url}
                  alt={featuredImage.alt}
                  inferSize
                  class="rounded-md aspect-[120/63] object-cover"
                  loading={index < 6 ? "eager" : "lazy"}
                />
                <div class="space-y-2">
                  <span class="text-xs items-end bg-primary/30 rounded-full w-fit px-2 py-1">
                    {category.name}
                  </span>
                  <h2 class="text-2xl font-medium" set:html={title} />
                  <p
                    class="text-sm text-foreground/70 line-clamp-3"
                    set:html={excerpt}
                  />
                  <p class="text-xs text-muted-foreground">{date}</p>
                </div>
              </div>
            </a>
          );
        })
      }
    </div>
  </section></Layout
>
