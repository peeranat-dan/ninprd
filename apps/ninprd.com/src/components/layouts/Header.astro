---
import { buttonVariants } from "@ninprd/ui/components/button";
import { BookOpen } from "lucide-react";

import { Icons } from "../icons";
import { ThemeToggle } from "../theme/theme-toggle";
import WebringLogo from "../WebringLogo.astro";
---

<header class="border-grid sticky top-0 z-50 w-full px-4 lg:px-0 py-2">
  <div
    class="max-w-5xl px-4 mx-auto border rounded-full bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 flex h-14 items-center justify-between"
  >
    <div class="flex h-14 items-center justify-between w-full">
      <div class="mr-4 flex gap-2">
        <a href="/" class="flex items-center space-x-2">
          <BookOpen className="w-4 h-4" />
          <span class="font-medium sm:inline-block">NINPRD</span>
        </a>
        <WebringLogo />
      </div>
      <div class="flex items-center justify-between gap-2 md:justify-end">
        <nav class="flex items-center gap-0.5 sm:gap-1">
          <a
            href="/blog"
            class="text-sm font-medium transition-colors hover:text-foreground/80"
          >
            Blog
          </a>
          <!-- <a
            href="/about"
            class="text-sm font-medium transition-colors hover:text-foreground/80"
          >
            About
          </a> -->
          <a
            class={buttonVariants({ size: "icon", variant: "ghost" })}
            href="https://github.com/peeranat-dan"
            target="_blank"
            rel="noreferrer"
            aria-label="Go to my GitHub profile"
          >
            <Icons.gitHub className="w-5 h-5" />
          </a>
          <ThemeToggle client:load />
        </nav>
      </div>
    </div>
  </div>
</header>
