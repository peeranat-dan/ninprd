  <Image
    alt="วงแหวนเว็บ"
    width="24"
    height="24"
    src={WebringLight}
    class="block dark:hidden"
    loading="eager"
  />
  <Image
    alt="วงแหวนเว็บ"
    width="24"
    height="24"
    src={WebringDark}
    class="hidden dark:block"
    loading="eager"
  />
