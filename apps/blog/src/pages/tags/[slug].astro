---
import { getCollection } from 'astro:content'
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from '@ninprd/ui/components/breadcrumb'
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro'
import BlogCard from '../../components/BlogCard.astro'
import Layout from '../../layouts/Layout.astro'

export const getStaticPaths = (async () => {
  const collection = await getCollection('blog')
  if (!collection) return []
  const postTags = collection.flatMap((post) => post.data.tags || [])
  const uniqueTags = Array.from(new Set(postTags))
  return uniqueTags.map((tag) => {
    return {
      params: {
        slug: tag,
      },
    }
  })
}) satisfies GetStaticPaths

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { slug } = Astro.params

const collection = await getCollection('blog')
const posts = collection
  .filter((post) => post.data.tags.includes(slug))
  .map((p) => {
    return {
      id: p.id,
      ...p.data,
    }
  })
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
---

<Layout
  title={`Posts tagged with "${slug}"`}
  description={`A list of posts tagged with "${slug}"`}
>
  <section class="mx-auto w-full max-w-5xl space-y-8 px-4 py-4">
    <div>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink
              href="/"
              className="text-primary font-semibold hover:text-primary"
              >หน้าหลัก</BreadcrumbLink
            >
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>tag: {slug}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
    </div>
    <h1 set:html={`All posts tagged with: ${slug}`} />
    <div class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, index) => (
          <BlogCard
            id={post.id}
            title={post.title}
            excerpt={post.excerpt}
            date={post.date}
            featuredImage={post.featuredImage}
            loading={index < 5 ? 'eager' : 'lazy'}
          />
        ))
      }
    </div>
  </section>
</Layout>
